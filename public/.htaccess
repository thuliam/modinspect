Options -Indexes
RewriteEngine On
# A visible .php address is sent to the clean one (/index.php -> /, /x.php -> /x); the front controller below is an internal rewrite, so it never loops.
RewriteCond %{THE_REQUEST} "^[A-Z]+ (/(?:[^ ?]*/)?)index\.php[ ?]"
RewriteRule ^ %1 [R=301,L]
RewriteCond %{THE_REQUEST} "^[A-Z]+ (/[^ ?]*?)\.php[ ?]"
RewriteRule ^ %1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]


# Fonts are public assets; allow cross-origin use so the site works when the page host differs from APP_URL (e.g. localhost vs LAN IP).
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2?|ttf|otf)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# Baseline security headers. No Content-Security-Policy yet (inline motion script and art sizing must move to files first), and no HSTS
# until HTTPS works on every page. See docs/DEPLOYMENT_RUNBOOK_HOSTATOM.md.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # Content-Security-Policy, ENFORCING since LS-21 (owner decision 2026-11-19; it was report-only from LS-19). No view has an inline script or handler
    # (tests/ls20_csp_ready_test.php keeps it so) and a 35-page sweep found no violation. Inline style attributes stay allowed (reveal delays, Select2
    # sizing). The sign-in form may redirect to the three providers. Violations are posted to /csp-report and logged as "[modinspect-csp]" lines in the
    # server log. To roll back, change the header name below to Content-Security-Policy-Report-Only (docs/CSP_ENFORCE.md).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://accounts.google.com https://login.microsoftonline.com https://www.facebook.com; report-uri /csp-report"
</IfModule>

# Performance (LS-2 H-9). Every block is conditional, so a host without the module simply skips it.
# Compression for text assets.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
# Static assets are cached by the browser; PHP pages are not (they send their own no-store headers).
# Files requested with ?v=<number> (the app appends the file modification time) never change under that URL, so they may be cached for a year.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType text/javascript "access plus 1 hour"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/x-icon "access plus 7 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType application/font-woff "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
    <If "%{QUERY_STRING} =~ /(^|&)v=[0-9]+/ && %{REQUEST_URI} =~ /\.(css|js|png|jpe?g|svg|ico|woff2?)$/">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
