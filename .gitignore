.env
.env.*
!.env.example
!.env.testing.example

# Composer vendor dir only. The admin UI libraries under public/assets/admin/vendor MUST be tracked
# (hash-pinned by MANIFEST.json) or a clean checkout has no working admin UI.
/vendor/
!public/assets/admin/vendor/
node_modules/

*.log
storage/logs/*
storage/cache/*
storage/sessions/*
storage/import/
var/import/

.idea/
.vscode/

Thumbs.db
.DS_Store
storage/import_uploads/
storage/research/

# Database backups hold everything (password hashes, raw listing text): never commit them
storage/backups/

# LS-14: member photos and report evidence (bank slips) are private and must never be committed
storage/uploads/
