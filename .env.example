APP_ENV=local
APP_URL=http://localhost/modinspect/public
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=modinspect
DB_USERNAME=root
DB_PASSWORD=

# Closed pilot (docs/PILOT_SCOPE_TH.md): true = nothing is indexed and every page shows the pilot notice. Keep false until the owner starts the pilot.
APP_PILOT=false

MODINSPECT_LIVE_COLLECTION_ENABLED=false
MODINSPECT_PAID_PROVIDER_CALLS_ENABLED=false

GEMINI_PROVIDER_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MAX_REQUESTS_PER_RUN=3
GEMINI_TIMEOUT_SECONDS=10

# Optional: lengthen admin sessions on a development machine (defaults 1800 idle / 28800 absolute; keep defaults in production)
# AUTH_IDLE_TIMEOUT_SECONDS=28800
# AUTH_ABSOLUTE_LIFETIME_SECONDS=604800

# LS-14 visitor sign-in (leave empty to keep sign-in closed). Redirect URI: {APP_URL}/account/callback/google|microsoft|facebook
MEMBER_GOOGLE_CLIENT_ID=
MEMBER_GOOGLE_CLIENT_SECRET=
MEMBER_MICROSOFT_CLIENT_ID=
MEMBER_MICROSOFT_CLIENT_SECRET=
MEMBER_FACEBOOK_APP_ID=
MEMBER_FACEBOOK_APP_SECRET=
MEMBER_FACEBOOK_GRAPH_VERSION=v19.0

# LS-14 Module 8 (ADR-007): seller check. Keep OFF until the owner and a lawyer approve the wording (HG-14). The key must be a long random secret (HG-18).
SELLER_CHECK_ENABLED=false
SELLER_CHECK_HMAC_KEY=
# LS-14 Module 9: show approved seller listings to everyone (HG-16)
SELLER_LISTINGS_PUBLIC=false

# LS-21 community reports (R-11): visitors report a wrong model, an old price, a spec or a sold price (choices and numbers only, no text).
# Off until the owner approves the privacy wording. Needs a long random key (32+ characters): openssl rand -hex 32
COMMUNITY_REPORTS_ENABLED=false
COMMUNITY_REPORTS_HMAC_KEY=
# LS-24 M9: threads, replies and reviews. Keep false until the owner has approved the community rules and the privacy wording.
COMMUNITY_FORUM_ENABLED=false
